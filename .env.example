# =================================================================
# MTC DAM - Production Environment Variables
# =================================================================

# 1. Database Configuration
# SQLite example (default):
DATABASE_URL="file:./dev.db"
# PostgreSQL example (if switching to Postgres):
# DATABASE_URL="postgresql://user:password@hostname:5432/mtc_dam?schema=public"

# 2. Authentication
# Generate a strong 32+ character random string
JWT_SECRET="replace-with-a-very-secure-random-secret-key"

# 3. Application Domain (Required for share links and email links)
NEXT_PUBLIC_APP_URL="https://dam.yourdomain.com"

# 4. Storage - Nextcloud / WebDAV (Optional: falls back to public/storage if not set)
NEXTCLOUD_URL="https://your-nextcloud.com/remote.php/webdav/"
NEXTCLOUD_USERNAME="your-webdav-user"
NEXTCLOUD_PASSWORD="your-webdav-app-password"

# 5. Email Notifications - SMTP (Optional)
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="smtp-username"
SMTP_PASSWORD="smtp-password"
SMTP_FROM="noreply@yourdomain.com"

# 6. Cloudflare Tunnel (Optional - only needed if running via docker-compose with Cloudflare Tunnel)
CLOUDFLARE_TUNNEL_TOKEN=""

